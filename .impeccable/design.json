  "narrative": {
    "northStar": "The local field guide",
    "overview": "The selected direction makes local technology support approachable through clear service routes, plain language and generous bright space. Bold forest-green headings and warm gold actions connect the page to the supplied Gem Infotech logo. The white opening leads into a dark green approach section, then a quiet service directory, local coverage and a practical contact flow.\n\nThis document records the built static implementation in `index.html`, `style.css`, `script.js` and the editorial pages generated by `scripts/build.mjs`. The approved visual reference is `.impeccable/mocks/decision/pick.png`, extended by the authorized connected-workspace hero. The supplied logo is authoritative. The workspace photograph is illustrative, not evidence of a customer project or company office.",
    "keyCharacteristics": [
      "Locally hosted Manrope with bold, tightly tracked headings.",
      "Bright surfaces, forest-green anchors and warm gold actions.",
      "Broad audience routes and thin-rule service lists.",
      "Flat page surfaces, restrained corners and consistent line icons.",
      "One connected-workspace scene with user-controlled motion.",
      "Explicit email draft preparation with no delivery claim."
    ],
    "rules": [
      {
        "name": "The One Focal Motion Rule",
        "body": "Keep motion inside the connected scene; its caption and service-link text stay still. Manual pause, offscreen observation and document visibility pause the animations. Reduced motion disables animations and transitions, removes scene transforms and hides the motion control. No JavaScript also leaves the scene static and hides its motion control. Preserve these alternatives whenever the scene changes.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Preserve the supplied Gem Infotech logo and its proportions.",
      "Use clear service language, visible contact details and the existing audience routes.",
      "Keep the service directory flat, separated by thin rules.",
      "Preserve keyboard focus, explicit validation and reduced-motion behavior.",
      "Describe the contact result as a draft requiring the visitor to send it."
    ],
    "donts": [
      "Invent customer counts, rankings, testimonials or managed IT offerings.",
      "Replace the supplied logo with a generated approximation.",
      "Spread the scene-label shadow across page panels or add repeated entrance effects.",
      "Claim the contact request was sent or delivered."
    ]
  }
